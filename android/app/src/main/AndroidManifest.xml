<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Sync talks to other devices this person owns, on the network they are
      both on. Nothing here reaches a server: there isn't one.

      CHANGE_WIFI_MULTICAST_STATE is the one that is easy to leave out and
      hard to notice missing. Without the lock it grants, multicast receive
      silently delivers no packets and reports no error — discovery appears to
      run and finds an empty network, on a network that is not empty.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
      Location, for geofence cues (§2.4.1) and nothing else. No coordinate is
      ever written to the log: a cue names a place the person chose, and what
      is recorded is that they chose it.

      BACKGROUND is separate and asked for separately, because a geofence that
      only works while the app is open is a geofence that never works — and
      Android makes granting it a deliberate trip to Settings, which is the
      right amount of friction for something that watches where you are.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The microphone, for hold-to-talk (§2.2). Asked for at the moment
      somebody reaches for it rather than at launch: capture works without it,
      and a prompt before anything has explained why is the one most often
      refused permanently.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Alarms, for the moments a capture named.

      SCHEDULE_EXACT_ALARM is granted in Settings from Android 13 rather than
      by a prompt, and is asked for only when something time-critical is first
      scheduled. Where it is refused the alarm falls back to inexact — "around
      2pm" rather than 2pm — and the health surface says so, because a cue
      firing at the wrong time is worse than one admitting it cannot be sure.

      USE_EXACT_ALARM is deliberately *not* requested. It is granted without
      asking, and is meant for alarm clocks and calendars whose entire purpose
      is exact timing; claiming it here would be taking by assertion what the
      other one asks for.

      RECEIVE_BOOT_COMPLETED because alarms do not survive a restart. A phone
      that rebooted overnight would otherwise stop alerting and give no sign.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".App"
        android:label="capture"
        android:supportsRtl="true"
        android:allowBackup="false">
        <!--
          allowBackup is off deliberately. The archive is an append-only log
          with a per-device identity in it; a platform backup restored onto a
          second device would give two devices one origin, which means two
          devices issuing the same sequence numbers. §1 mints a new incarnation
          on restore for exactly this reason, and a silent cloud copy would
          bypass it.
        -->

        <!-- The reading surface. Where you go, rather than a gesture. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="capture">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The capture window. A dialog rather than a full screen: it is meant
          to feel like something that appeared over what you were doing, not
          somewhere you navigated to — and it is shown over the lock screen,
          because the tile that opens it is reachable from there and demanding
          an unlock afterwards would put the gesture behind the thing it was
          avoiding.
        -->
        <activity
            android:name=".CaptureActivity"
            android:exported="true"
            android:theme="@style/CaptureDialog"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="stateVisible|adjustResize">

            <!--
              The assistant gesture (§8.10: long-press home → hold-to-talk).

              Registering for ASSIST lets somebody choose capture as their
              assist app, so the gesture that is already in their hand opens
              the capture window instead of a search box.

              It opens the window and does **not** start recording. The
              gesture can fire by accident — a long press against a pocket is
              exactly the shape of it — and a device that began recording on
              an accidental gesture is the failure hold-to-talk was designed
              to make impossible. The assistant gesture replaces finding the
              application; the capture gesture is still the person's.
            -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Capture, as an icon.

          An `activity-alias` rather than a second activity: it is the same
          window, reached by a second name. The launcher shows it beside the
          application's own icon, and it can be dragged onto a home screen like
          anything else — which is the point, because the home screen is where
          a thumb already is.

          A home-screen widget was tried here first and removed. `RemoteViews`
          has no `EditText`, so a widget could only ever draw a *picture* of a
          field and open the real one on tap — an icon does the same thing with
          nothing to place, nothing to resize, and no second surface to keep
          working.

          `targetActivity` is exported already; the alias inherits nothing and
          declares its own exported state, which has to be true for the
          launcher to start it.
        -->
        <activity-alias
            android:name=".CaptureShortcut"
            android:targetActivity=".CaptureActivity"
            android:exported="true"
            android:label="Capture">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          The share-sheet target. Invisible: it captures and finishes, because
          a share sheet is already a deliberate act with the content chosen,
          and asking to confirm would ask the same question twice.

          Translucent rather than NoDisplay. NoDisplay requires the activity to
          call finish() before onResume() completes, and this one cannot: the
          capture has to be committed before it reports success, and that is
          asynchronous. With NoDisplay the platform throws, the process dies,
          and the shared text is lost — which was the first version's actual
          behaviour, and the failure it produces is invisible from the sharing
          application's side.
        -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:label="capture">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Selected text in any app, without leaving it. -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".CaptureTile"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_edit"
            android:label="capture"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- Offered on the lock screen. The point of the surface. -->
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>

        <!--
          Where the platform delivers a boundary crossing. Exported false: the
          only sender that matters is the system, and an exported receiver here
          would let any application on the device claim somebody had arrived
          somewhere.
        -->
        <receiver
            android:name=".Arrival"
            android:exported="false" />

        <!--
          The alarm arriving. Exported false: the only sender that matters is
          the platform, and an exported receiver here would let any application
          make this phone announce somebody's notes.
        -->
        <receiver
            android:name=".Ring"
            android:exported="false" />

        <!--
          A restart, and a change of time zone. Exported false for the same
          reason; both broadcasts are delivered to the package regardless.

          The zone belongs here rather than being read when something happens
          to run. Every quiet-hours and batching decision takes the local hour
          as its input, and an alarm is an instant that was worked out in
          whatever zone the phone was in when it was set. Neither is recomputed
          by anything else, so after a flight the afternoon reads as quiet hours
          and what does get said arrives in the middle of the night.
        -->
        <receiver
            android:name=".Restarted"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
