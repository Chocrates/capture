<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Sync talks to other devices this person owns, on the network they are
      both on. Nothing here reaches a server: there isn't one.

      CHANGE_WIFI_MULTICAST_STATE is the one that is easy to leave out and
      hard to notice missing. Without the lock it grants, multicast receive
      silently delivers no packets and reports no error — discovery appears to
      run and finds an empty network, on a network that is not empty.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
      Location, for geofence cues (§2.4.1) and nothing else. No coordinate is
      ever written to the log: a cue names a place the person chose, and what
      is recorded is that they chose it.

      BACKGROUND is separate and asked for separately, because a geofence that
      only works while the app is open is a geofence that never works — and
      Android makes granting it a deliberate trip to Settings, which is the
      right amount of friction for something that watches where you are.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="capture"
        android:supportsRtl="true"
        android:allowBackup="false">
        <!--
          allowBackup is off deliberately. The archive is an append-only log
          with a per-device identity in it; a platform backup restored onto a
          second device would give two devices one origin, which means two
          devices issuing the same sequence numbers. §1 mints a new incarnation
          on restore for exactly this reason, and a silent cloud copy would
          bypass it.
        -->

        <!-- The reading surface. Where you go, rather than a gesture. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="capture">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The capture window. A dialog rather than a full screen: it is meant
          to feel like something that appeared over what you were doing, not
          somewhere you navigated to — and it is shown over the lock screen,
          because the tile that opens it is reachable from there and demanding
          an unlock afterwards would put the gesture behind the thing it was
          avoiding.
        -->
        <activity
            android:name=".CaptureActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!--
          The share-sheet target. Invisible: it captures and finishes, because
          a share sheet is already a deliberate act with the content chosen,
          and asking to confirm would ask the same question twice.

          Translucent rather than NoDisplay. NoDisplay requires the activity to
          call finish() before onResume() completes, and this one cannot: the
          capture has to be committed before it reports success, and that is
          asynchronous. With NoDisplay the platform throws, the process dies,
          and the shared text is lost — which was the first version's actual
          behaviour, and the failure it produces is invisible from the sharing
          application's side.
        -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:label="capture">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Selected text in any app, without leaving it. -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".CaptureTile"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_edit"
            android:label="capture"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- Offered on the lock screen. The point of the surface. -->
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>

        <!--
          Where the platform delivers a boundary crossing. Exported false: the
          only sender that matters is the system, and an exported receiver here
          would let any application on the device claim somebody had arrived
          somewhere.
        -->
        <receiver
            android:name=".Arrival"
            android:exported="false" />

    </application>
</manifest>
